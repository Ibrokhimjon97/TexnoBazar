# Brauzer uchun ochiq Supabase sozlamalari
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Faqat server uchun (VITE_ prefiksini qo‘ymang)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Bir martalik superadmin bootstrap (faqat root .env.local uchun)
SUPERADMIN_EMAIL=owner@example.uz
SUPERADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SUPERADMIN_FULL_NAME=Bosh administrator

# Cloudflare R2 server sozlamalari
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://media.example.uz

# Storefront absolute URL (sitemap, robots va canonical uchun)
STOREFRONT_BASE_URL=https://texnobazar.example.uz

# Telegram Bot API (faqat server uchun)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_WEBHOOK_SECRET

# R2 cleanup worker endpoint uchun Bearer secret (faqat server/scheduler)
MEDIA_CLEANUP_SECRET=REPLACE_WITH_A_RANDOM_CLEANUP_SECRET
CRON_SECRET=REPLACE_WITH_THE_SAME_RANDOM_CLEANUP_SECRET
