# Brauzer uchun ochiq Supabase sozlamalari
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Faqat server uchun (VITE_ prefiksini qo‘ymang)
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Bir martalik superadmin bootstrap (faqat root .env.local uchun)
SUPERADMIN_EMAIL=owner@example.uz
SUPERADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
SUPERADMIN_FULL_NAME=Bosh administrator

# Cloudflare R2 server sozlamalari
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET_NAME
R2_PUBLIC_BASE_URL=https://media.example.uz

# Storefront absolute URL (sitemap, robots va canonical uchun)
STOREFRONT_BASE_URL=https://texnobazar.example.uz

# Telegram Bot API (faqat server uchun)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_WEBHOOK_SECRET

# R2 cleanup worker endpoint uchun Bearer secret (faqat server/scheduler)
MEDIA_CLEANUP_SECRET=REPLACE_WITH_A_RANDOM_CLEANUP_SECRET
CRON_SECRET=REPLACE_WITH_THE_SAME_RANDOM_CLEANUP_SECRET

# AI yordamchi
# Media endpoint'lari superadmin deploymentida joylashadi.
# Manager production build uchun superadmin ilovasining canonical originini yozing (oxirida / bo‘lmasin).
VITE_API_BASE=
# Masalan dev: VITE_API_BASE=http://localhost:5174
# Masalan prod: VITE_API_BASE=https://texnobazar-admin.netlify.app

# AI endpoint'lari superadmin deploymentida joylashadi (API kalitlar faqat u yerda o'qiladi).
# Superadmin app uchun bo'sh qoldiring (o'zining /api yo'lini ishlatadi).
# Manager app uchun superadmin ilovasining to'liq manzilini yozing.
VITE_AI_API_BASE=
# Masalan dev: VITE_AI_API_BASE=http://localhost:5174
# Masalan prod: VITE_AI_API_BASE=https://admin.texnobazar.example.uz
#
# AI provayder API kalitlari (OpenAI/Gemini/Claude/Groq/Kimi) .env da SAQLANMAYDI —
# ular superadmin panelidagi "AI sozlamalari" bo'limida kiritiladi va bazada saqlanadi.

# AI endpoint'lariga murojaat qilishi mumkin bo'lgan origin'lar (vergul bilan).
# Bo'sh qoldirilsa faqat localhost dev portlari ruxsat etiladi.
# Productionda manager ilovasining manzilini yozing.
AI_ALLOWED_ORIGINS=
# Masalan: AI_ALLOWED_ORIGINS=https://manager.texnobazar.example.uz,https://admin.texnobazar.example.uz
